<view class="page">
  <view class="card row">
    <view class="logo"><view class="logo-dot a"></view><view class="logo-dot b"></view><view class="logo-link"></view></view>
    <view class="col" style="gap:6rpx">
      <view class="h">心里韧带</view>
      <view class="sub">身体在康复，心也在慢慢恢复力量。</view>
    </view>
  </view>

  <view class="card col">
    <view class="between">
      <text class="sub" style="font-weight:700">今天感觉怎么样？</text>
      <text class="mut">点一点，去记录</text>
    </view>
    <view class="moods">
      <button wx:for="{{moods}}" wx:key="label" class="mood" data-i="{{index}}" bindtap="onMood">
        <view class="face" style="border-color:{{item.color}};color:{{item.color}}"></view>
        <text>{{item.label}}</text>
      </button>
    </view>
  </view>

  <view class="grid">
    <button wx:for="{{modules}}" wx:key="key" class="mod" data-key="{{item.key}}" bindtap="onMod">
      <view class="badge">{{item.badge}}</view>
      <text class="sub" style="font-weight:700;color:#22333B">{{item.title}}</text>
      <text class="mut">{{item.desc}}</text>
    </button>
  </view>

  <view class="card col" style="gap:4rpx">
    <text class="mut">每日一句</text>
    <text class="sub">康复不是回到过去，而是带着经验重新出发。</text>
  </view>

  <view class="mut center">故事来自公开报道 · 对话为内置演示 · 非医疗诊断</view>
</view>