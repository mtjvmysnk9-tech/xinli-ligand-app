<view class="page" wx:if="{{article}}">
  <view class="col" style="gap:12rpx">
    <view class="h" style="font-size:34rpx;line-height:1.5">{{article.title}}</view>
    <view class="sub">{{article.intro}}</view>
  </view>
  <view wx:for="{{article.sections}}" wx:for-item="sec" wx:key="h" class="card col">
    <view class="sub" style="font-weight:700;color:#22333B">{{sec.h}}</view>
    <view wx:for="{{sec.items}}" wx:for-item="it" wx:key="*this" class="li">
      <view class="dot"></view><text>{{it}}</text>
    </view>
  </view>
  <view class="mut">科普内容仅供参考，不能替代专业评估；具体康复请遵医嘱。</view>
</view>
<view wx:else class="page"><view class="mut center">没有找到这篇科普</view></view>