.note { width: 100%; height: 160rpx; border: 1rpx solid #E5E1D8; border-radius: 20rpx; padding: 20rpx; font-size: 24rpx; background: #FAF8F3; color: #22333B; }
.trend { width: 100%; height: 252rpx; }
.legend { width: 16rpx; height: 6rpx; border-radius: 999rpx; }
.entry { border-top: 1rpx solid #E5E1D8; padding-top: 16rpx; display: flex; flex-direction: column; gap: 8rpx; }
.entry:first-of-type { border-top: none; padding-top: 0; }
.tag { font-size: 20rpx; border: 1rpx solid; border-radius: 999rpx; padding: 2rpx 14rpx; }